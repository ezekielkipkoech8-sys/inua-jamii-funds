# ============================================================
# Inua Jamii Funds — environment variables
# Copy this file to .env and fill in real values.
# IMPORTANT: .env holds secrets — NEVER commit it to git.
# Add `.env` to your `.gitignore`.
# ============================================================

# HashBack Payment Gateway credentials (from your HashBack dashboard).
HASHBACK_API_KEY=your_hashback_api_key_here
HASHBACK_ACCOUNT_ID=YOUR_HASHBACK_ACCOUNT_ID

# Secret used to verify HashBack webhook signatures (HMAC-SHA256).
# Must match the secret configured in your HashBack account dashboard.
HASHBACK_WEBHOOK_SECRET=your_hashback_webhook_secret_here

# Port the webhook server listens on.
PORT=3000
